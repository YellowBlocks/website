# ---------------------------------------------------------------------------
# YellowBlocks website – environment variables
# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are embedded in the browser bundle: no secrets there.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for canonicals, sitemap, OG, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://yellowblocks.nl

# Set to 0 on preview/staging deployments: robots.txt then disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=1

# Show "Ter goedkeuring" markers on unapproved facts. Default: on in dev, off in production.
# NEXT_PUBLIC_SHOW_REVIEW_MARKERS=1

# --- Content (Sanity) -------------------------------------------------------
# Leave empty to use the typed seed content in src/lib/content/local.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Viewer token, server-only. Needed for draft previews.
SANITY_API_READ_TOKEN=
# Shared secret for /api/draft (Studio "Open preview").
SANITY_PREVIEW_SECRET=
# Shared secret for the Sanity publish webhook -> /api/revalidate.
SANITY_REVALIDATE_SECRET=

# --- Contact form e-mail delivery (Resend) ------------------------------------
# Without these, the form validates but refuses to send in production and shows the phone number.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "YellowBlocks website <website@yellowblocks.nl>"
CONTACT_FROM_EMAIL=

# --- Conversion helpers -------------------------------------------------------
# Optional booking link (e.g. Microsoft Bookings). Shown on the contact page when set.
NEXT_PUBLIC_SCHEDULING_URL=
# Optional URL of an approved, anonymised sample report (PDF).
NEXT_PUBLIC_SAMPLE_REPORT_URL=

# --- Analytics ----------------------------------------------------------------
# none | plausible | ga4
#   plausible: cookieless, loaded without a banner
#   ga4: loaded only after explicit consent via the built-in banner
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yellowblocks.nl
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Build ---------------------------------------------------------------------
# Set to 1 for a self-contained Node server (Docker / Azure App Service / Container Apps).
BUILD_STANDALONE=0
